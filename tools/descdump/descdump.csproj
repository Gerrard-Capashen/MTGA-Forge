<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <RollForward>Major</RollForward>
    <!-- The client's MTGA_Data\Managed folder; tools\gen-protos.ps1 passes -p:ManagedDir=... -->
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(MSBuildThisFileDirectory)..\..\client\MTGA_Data\Managed</ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Google.Protobuf"><HintPath>$(ManagedDir)\Google.Protobuf.dll</HintPath></Reference>
  </ItemGroup>
</Project>

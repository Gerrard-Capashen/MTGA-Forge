<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ForgeBridge</AssemblyName>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>   <!-- no pdb path (this machine's folders) inside the shipped binary -->
    <NoWarn>MSB3277;CS1701;CS1702;CS8981</NoWarn>
    <!-- The client's MTGA_Data\Managed folder (override with -p:ManagedDir=...) -->
    <ManagedDir Condition="'$(ManagedDir)' == ''">$(MSBuildThisFileDirectory)..\..\client\MTGA_Data\Managed</ManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- Always compile against the ORIGINAL Core.dll so rebuilds don't depend on our own patch -->
    <Reference Include="Core"><HintPath>$(ManagedDir)\Core.dll.orig</HintPath><Private>false</Private></Reference>
    <Reference Include="$(ManagedDir)\*.dll" Exclude="$(ManagedDir)\Core.dll;$(ManagedDir)\ForgeBridge.dll;$(ManagedDir)\mscorlib.dll;$(ManagedDir)\netstandard.dll;$(ManagedDir)\System*.dll;$(ManagedDir)\Microsoft.*.dll;$(ManagedDir)\Mono.*.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>

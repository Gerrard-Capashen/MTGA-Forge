<Window x:Class="MtgaForgeLauncher.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Uninstall MTGA Forge" Width="600" Height="680" MinHeight="600" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" FontFamily="{StaticResource Ui}" FontSize="14" UseLayoutRounding="True">
  <Grid Margin="0" Background="{StaticResource Bg}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <StackPanel Margin="28,24,28,0">
      <TextBlock Text="Uninstall MTGA Forge" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,18"
                 Text="Choose what to remove. Your MTGA install and your MTGA account are never touched, and neither is Forge's own profile or art cache."/>
    </StackPanel>

    <ItemsControl Grid.Row="1" Margin="28,0" ItemsSource="{Binding Items}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,10">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
              <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding Exists}" VerticalAlignment="Center">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="360"/>
                </StackPanel>
              </CheckBox>
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Grid.Row="2" Margin="28,0,28,20">
      <TextBlock x:Name="Result" TextWrapping="Wrap" Margin="0,4,0,12" Foreground="{StaticResource Muted}"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="Cancel" Content="Cancel" Click="Cancel_Click" MinWidth="90"/>
        <Button x:Name="Remove" Style="{StaticResource Primary}" Content="Remove selected" Click="Remove_Click" Margin="10,0,0,0"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>

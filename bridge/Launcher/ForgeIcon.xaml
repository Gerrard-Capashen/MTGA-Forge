<UserControl x:Class="MtgaForgeLauncher.ForgeIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Molten anvil and hammer (PNG art), glow and impact effects are animated from ForgeIcon.xaml.cs -->
  <Viewbox Stretch="Uniform">
    <Canvas Width="512" Height="512">
      <Ellipse x:Name="Shadow" Canvas.Left="86" Canvas.Top="468" Width="340" Height="26" Fill="#40000000" RenderTransformOrigin="0.5,0.5">
        <Ellipse.RenderTransform><ScaleTransform x:Name="ShadowScale"/></Ellipse.RenderTransform>
      </Ellipse>
      <Canvas x:Name="Floating">
        <Canvas.RenderTransform><TranslateTransform x:Name="FloatMove"/></Canvas.RenderTransform>
        <Ellipse x:Name="Halo" Canvas.Left="36" Canvas.Top="170" Width="440" Height="300" Opacity="0">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#FFFF8A2B" Offset="0"/><GradientStop Color="#80E0390A" Offset="0.45"/><GradientStop Color="#00E0390A" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <Canvas x:Name="Anvil" Canvas.Left="56" Canvas.Top="215" Width="400" Height="249" RenderTransformOrigin="0.5,1">
          <Canvas.RenderTransform><ScaleTransform x:Name="AnvilSquash"/></Canvas.RenderTransform>
          <Image Source="anvil.png" Width="400" Height="249"/>
          <Image x:Name="AnvilLava" Source="anvil-lava.png" Width="400" Height="249" />
          <Image x:Name="AnvilBloom" Source="anvil-lava.png" Width="400" Height="249" Opacity="0"><Image.Effect><BlurEffect Radius="14"/></Image.Effect></Image>
        </Canvas>

        <Ellipse x:Name="Flash" Canvas.Left="320" Canvas.Top="175" Width="120" Height="80" Opacity="0" RenderTransformOrigin="0.5,0.5">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#FFFFF3C4" Offset="0"/><GradientStop Color="#C0FFB347" Offset="0.4"/><GradientStop Color="#00FF6A00" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
          <Ellipse.RenderTransform><ScaleTransform x:Name="FlashScale"/></Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse x:Name="Ring" Canvas.Left="330" Canvas.Top="205" Width="100" Height="20" Opacity="0" Stroke="#FFFFC66B" StrokeThickness="4" RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform><ScaleTransform x:Name="RingScale"/></Ellipse.RenderTransform>
        </Ellipse>

        <Canvas x:Name="Hammer">
          <Canvas.RenderTransform>
            <TransformGroup>
              <RotateTransform x:Name="HammerTilt" CenterX="380" CenterY="215"/>
              <TranslateTransform x:Name="HammerMove"/>
            </TransformGroup>
          </Canvas.RenderTransform>
          <Image Source="hammer.png" Canvas.Left="118" Canvas.Top="99" Width="300" Height="116"/>
          <Image x:Name="HammerLava"  Source="hammer-lava.png" Canvas.Left="118" Canvas.Top="99" Width="300" Height="116"/>
          <Image x:Name="HammerBloom" Source="hammer-lava.png" Canvas.Left="118" Canvas.Top="99" Width="300" Height="116" Opacity="0"><Image.Effect><BlurEffect Radius="10"/></Image.Effect></Image>
        </Canvas>
        <Canvas x:Name="Sparks"/>
      </Canvas>
    </Canvas>
  </Viewbox>
</UserControl>

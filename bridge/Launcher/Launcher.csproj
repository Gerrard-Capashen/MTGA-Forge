<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>MtgaForgeLauncher.Program</StartupObject>
    <AssemblyName>MTGA-Forge</AssemblyName>
    <RootNamespace>MtgaForgeLauncher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Product>MTGA-Forge</Product>
    <Description>Launcher for MTGA-Forge (unofficial fan project, not affiliated with the makers of MTGA)</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="anvil.png" />
    <Resource Include="forge-logo.png" />
    <Resource Include="hammer.png" />
    <Resource Include="anvil-lava.png" />
    <Resource Include="hammer-lava.png" />
  </ItemGroup>
</Project>

{
  "name": "mtga-forge-coordinator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply mtga-forge --remote",
    "db:migrate:local": "wrangler d1 migrations apply mtga-forge --local",
    "db:clean": "wrangler d1 execute mtga-forge --command \"DELETE FROM players WHERE name_lc LIKE 'zztest%'; DELETE FROM name_holds WHERE name_lc LIKE 'zztest%'\"",
    "typecheck": "tsc --noEmit",
    "test": "node test/smoke.mjs && node test/accounts.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.0.0"
  }
}
